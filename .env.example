# Copy to .env.local and fill in real values.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/profinance

# Canonical URL of the deployed app
NEXTAUTH_URL=http://localhost:3000

# Session encryption secret — generate with: openssl rand -base64 48
# NEVER commit the real value.
NEXTAUTH_SECRET=

# Document extraction provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
